# Test Genius Project - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# REQUIRED: Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OPTIONAL: Anthropic Claude API Key (preferred name, same as QC Next.js app)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Legacy alias (still supported if ANTHROPIC_API_KEY is not set)
# CLAUDE_API_KEY=your-claude-api-key-here

# Optional: model ID (default matches QC app)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional: copy .env.local from your Next.js project; it overrides .env when present
